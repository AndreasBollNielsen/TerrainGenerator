#pragma kernel CSMain

// -------------------------------------------------------------------------
// Output textures
// -------------------------------------------------------------------------
RWTexture2D<float>  ResultDepth;
RWTexture2D<float4> Result;

// -------------------------------------------------------------------------
// LOD-tiered heightmap arrays
// LOD 0 — 2048×2048  (3×3 inner ring)
// LOD 1 — 1024×1024  (5×5 ring)
// LOD 2 —  512×512   (outer ring)
// -------------------------------------------------------------------------
Texture2DArray<float> _HeightTexLOD0;
Texture2DArray<float> _HeightTexLOD1;
Texture2DArray<float> _HeightTexLOD2;
SamplerState sampler_HeightTexLOD0;
SamplerState sampler_HeightTexLOD1;
SamplerState sampler_HeightTexLOD2;

// -------------------------------------------------------------------------
// Flat 7×7 tile grid — O(1) lookup by world position
// Slot index = gx * 7 + gy where gx/gy are offsets from _CenterTile
// arrayIndex = -1 means tile not loaded
// -------------------------------------------------------------------------
struct TileData { int arrayIndex; int lodLevel; };
StructuredBuffer<TileData> _TileGrid;

// -------------------------------------------------------------------------
// Camera, terrain & scene uniforms
// -------------------------------------------------------------------------
uint   Width;
uint   Height;
float3 _CamPos;
float3 _CamForward;
float3 _CamRight;
float3 _CamUp;
float  _CamFov;
float  _CamAspect;
float3 _LightDir;
float  _HeightScale;
float  _TileWorldSize;
float  _MaxRayDistance;
int2   _CenterTile;

#define GRID_SIZE 7
#define GRID_HALF 3  // (GRID_SIZE - 1) / 2

// -------------------------------------------------------------------------
// O(1) height sample — direct grid slot lookup, no loops
// -------------------------------------------------------------------------
bool sampleHeight(float2 worldXZ, out float height)
{
    height = 0;

    int2 tileCoord = int2(floor(worldXZ / _TileWorldSize));
    int2 slot      = tileCoord - _CenterTile + GRID_HALF;

    if (any(slot < 0) || any(slot >= GRID_SIZE))
        return false;

    TileData td = _TileGrid[slot.x * GRID_SIZE + slot.y];
    if (td.arrayIndex < 0)
        return false;

    float2 tileOrigin = float2(tileCoord) * _TileWorldSize;
    float2 uv         = (worldXZ - tileOrigin) / _TileWorldSize;

    float h;
    if (td.lodLevel == 0)
        h = _HeightTexLOD0.SampleLevel(sampler_HeightTexLOD0, float3(uv, td.arrayIndex), 0).r;
    else if (td.lodLevel == 1)
        h = _HeightTexLOD1.SampleLevel(sampler_HeightTexLOD1, float3(uv, td.arrayIndex), 0).r;
    else
        h = _HeightTexLOD2.SampleLevel(sampler_HeightTexLOD2, float3(uv, td.arrayIndex), 0).r;

    height = h * _HeightScale;
    return true;
}

// Convenience wrapper returning 0 for out-of-range (used in normal estimation)
float sampleHeightRaw(float2 worldXZ)
{
    float h;
    sampleHeight(worldXZ, h);
    return h;
}

// -------------------------------------------------------------------------
// SDF
// -------------------------------------------------------------------------
float map(float3 p)
{
    float h;
    if (!sampleHeight(p.xz, h))
        return 1e6;

    return p.y - h;
}

// -------------------------------------------------------------------------
// Ray march — relaxed stepping (0.9×) avoids overstepping on slopes;
// minimum step prevents infinite stall on flat terrain
// -------------------------------------------------------------------------
bool trace(float3 ro, float3 rd, out float t)
{
    t = 0.01;

    for (int i = 0; i < 512; i++)
    {
        float3 pos = ro + rd * t;
        float  d   = map(pos);

        if (d < 0.1)
            return true;

        t += max(d * 0.9, 0.5);

        if (t > _MaxRayDistance)
            return false;
    }

    return false;
}

// -------------------------------------------------------------------------
// Normal — world-space finite differences, step scales with distance
// -------------------------------------------------------------------------
float3 calcTerrainNormal(float3 p, float t)
{
    float eps = clamp(t * 0.00025, 0.5, 4.0);

    float hxP = sampleHeightRaw(p.xz + float2( eps, 0));
    float hxN = sampleHeightRaw(p.xz + float2(-eps, 0));
    float hzP = sampleHeightRaw(p.xz + float2(0,  eps));
    float hzN = sampleHeightRaw(p.xz + float2(0, -eps));

    return normalize(float3(hxN - hxP, 2.0 * eps, hzN - hzP));
}

float lambert(float3 n, float3 l)
{
    return max(dot(n, l), 0.0);
}

// -------------------------------------------------------------------------
// Main kernel
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height)
        return;

    float2 uv = (id.xy / float2(Width, Height)) * 2.0 - 1.0;
    uv.x *= _CamAspect;

    float  tanHalfFov = tan(radians(_CamFov) * 0.5);
    float3 worldDir   = normalize(_CamForward
                                + uv.x * _CamRight * tanHalfFov
                                + uv.y * _CamUp    * tanHalfFov);
    float t;
    bool hit = trace(_CamPos, worldDir, t);

    if (hit)
    {
        float3 hitPos  = _CamPos + worldDir * t;
        float3 normal  = calcTerrainNormal(hitPos, t);
        float  diffuse = lambert(normal, normalize(_LightDir));
        float3 color   = float3(1, 1, 1) * (0.1 + diffuse);

        Result[id.xy]      = float4(color, 1);
        ResultDepth[id.xy] = t;
    }
    else
    {
        Result[id.xy]      = float4(0, 0, 0, 0);
        ResultDepth[id.xy] = _MaxRayDistance;
    }
}
